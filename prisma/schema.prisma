datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  name         String?
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships   WorkspaceMember[]
  sessions      Session[]
  results       VerificationResult[]
  jobs          VerificationJob[]
  ledgerEntries VerificationCreditLedger[]
  templates     EmailTemplate[]
  campaigns     Campaign[]
  emailSends    EmailSendRecord[]
  smsBroadcasts SmsBroadcast[]
  smsTemplates  SmsTemplate[]
  voiceCampaigns VoiceCampaign[]
  voiceTemplates VoiceTemplate[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Workspace {
  id           String                    @id @default(uuid())
  name         String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  members      WorkspaceMember[]
  contacts     Contact[]
  jobs         VerificationJob[]
  results      VerificationResult[]
  suppressions SuppressionEntry[]
  suppressionAuditLogs SuppressionAuditLog[]
  contactLists ContactList[]
  segments     Segment[]
  settings     VerificationSettings?
  ledger       VerificationCreditLedger[]
  templates    EmailTemplate[]
  campaigns    Campaign[]
  campaignSendingJobs CampaignSendingJob[]
  sendingDomains SendingDomain[]
  emailSends     EmailSendRecord[]
  webhookEvents  EmailWebhookEvent[]
  smsBroadcasts  SmsBroadcast[]
  smsTemplates   SmsTemplate[]
  smsSettings    SmsSettings?
  consentAuditLogs ContactConsentAuditLog[]
  voiceCampaigns VoiceCampaign[]
  voiceTemplates VoiceTemplate[]
  voiceSettings  VoiceSettings?
  voiceCallJobs  VoiceCallJob[]
  voiceCallEvents VoiceCallEvent[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        String    @default("OWNER") // OWNER, ADMIN, MEMBER
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Contact {
  id                 String                  @id @default(uuid())
  workspaceId        String
  email              String
  normalizedEmail    String
  firstName          String?
  lastName           String?
  name               String?
  phone              String?
  phoneNormalized    String?
  phoneCountry       String?
  smsConsent         String                  @default("PENDING") // PENDING, OPTED_IN, OPTED_OUT
  smsConsentSource   String?                 // MANUAL, IMPORT, WEB_FORM, KEYWORD_START, API
  smsConsentTimestamp DateTime?
  smsOptOutTimestamp DateTime?
  voiceConsent       String                  @default("PENDING") // PENDING, OPTED_IN, OPTED_OUT
  voiceConsentSource String?                 // MANUAL, IMPORT, WEB_FORM, IVR, API
  voiceConsentTimestamp DateTime?
  voiceOptOutTimestamp DateTime?
  company            String?
  jobTitle           String?
  tags               String[]                @default([])
  customFields       Json?
  notes              String?
  isArchived         Boolean                 @default(false)
  verificationStatus String                  @default("UNVERIFIED") // UNVERIFIED, VALID, INVALID, RISKY, UNKNOWN
  lastVerifiedAt     DateTime?
  subscriptionStatus String                  @default("PENDING") // PENDING, SUBSCRIBED, UNSUBSCRIBED, BOUNCED
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  results            VerificationResult[]
  lists              ContactListMembership[]
  campaignSnapshots  CampaignRecipientSnapshot[]
  consentAuditLogs   ContactConsentAuditLog[]
  voiceCallJobs      VoiceCallJob[]

  @@unique([workspaceId, normalizedEmail])
  @@index([workspaceId])
  @@index([workspaceId, verificationStatus])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, phoneNormalized])
  @@index([workspaceId, smsConsent])
  @@index([workspaceId, voiceConsent])
  @@index([normalizedEmail])
  @@map("contacts")
}

model ContactList {
  id          String                  @id @default(uuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships ContactListMembership[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("contact_lists")
}

model ContactListMembership {
  id        String      @id @default(uuid())
  contactId String
  listId    String
  createdAt DateTime    @default(now())
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([contactId, listId])
  @@index([contactId])
  @@index([listId])
  @@map("contact_list_memberships")
}

model Segment {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  description String?
  conditions  Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("segments")
}

model VerificationJob {
  id                 String               @id @default(uuid())
  workspaceId        String
  userId             String?
  filename           String
  fileSize           Int?
  sourceType         String               @default("MANUAL") // CSV, MANUAL, API, IMPORT, XLSX, TXT
  status             String               @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  totalRecords       Int                  @default(0)
  processedRecords   Int                  @default(0)
  duplicatesCount    Int                  @default(0)
  rejectedCount      Int                  @default(0)
  validCount         Int                  @default(0)
  invalidCount       Int                  @default(0)
  riskyCount         Int                  @default(0)
  unknownCount       Int                  @default(0)
  creditsUsed        Int                  @default(0)
  progressPercentage Float                @default(0)
  providerJobId      String?
  createdAt          DateTime             @default(now())
  completedAt        DateTime?
  cancelledAt        DateTime?
  errorMessage       String?
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  results            VerificationResult[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([userId])
  @@map("verification_jobs")
}

model VerificationResult {
  id                 String           @id @default(uuid())
  workspaceId        String
  jobId              String?
  userId             String?
  contactId          String?
  email              String
  normalizedEmail    String
  status             String // VALID, INVALID, RISKY, UNKNOWN
  provider           String           @default("REOON")
  verificationMode   String           @default("POWER") // POWER, QUICK
  providerStatus     String // Raw provider status (e.g. "safe", "invalid", "risky")
  providerSubstatus  String? // Raw substatus (e.g. "mailbox_not_found", "disposable")
  reason             String?
  overallScore       Int?
  isValidSyntax      Boolean?         @default(true)
  isDisposable       Boolean          @default(false)
  isRoleBased        Boolean          @default(false)
  isCatchAll         Boolean          @default(false)
  mxAcceptsMail      Boolean?         @default(true)
  canConnectSmtp     Boolean?
  isDeliverable      Boolean?
  isSpamtrap         Boolean?         @default(false)
  isDisabled         Boolean?         @default(false)
  hasInboxFull       Boolean?         @default(false)
  isFreeEmail        Boolean?         @default(false)
  domain             String?
  mxRecords          Json?
  providerResponse   Json?
  source             String           @default("SINGLE") // SINGLE, BULK
  isMock             Boolean          @default(false)
  verifiedAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())

  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job                VerificationJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contact            Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([jobId])
  @@index([workspaceId, jobId])
  @@index([workspaceId, normalizedEmail])
  @@index([workspaceId, verifiedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, isMock])
  @@map("verification_results")
}

model SuppressionEntry {
  id                   String    @id @default(uuid())
  workspaceId          String
  email                String?
  normalizedEmail      String
  reason               String
  source               String    @default("MANUAL") // MANUAL, IMPORT, BOUNCE, COMPLAINT, UNSUBSCRIBE, SYSTEM
  channel              String    @default("EMAIL") // EMAIL, SMS, ALL
  phone                String?
  normalizedPhone      String?
  notes                String?
  status               String    @default("ACTIVE") // ACTIVE, REMOVED
  addedByUserId        String?
  addedByUserEmail     String?
  removedAt            DateTime?
  removedByUserId      String?
  removedByUserEmail   String?
  removalJustification String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, normalizedEmail])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, reason])
  @@index([workspaceId, source])
  @@index([workspaceId, normalizedPhone])
  @@index([workspaceId, channel])
  @@map("suppression_entries")
}

model SuppressionAuditLog {
  id                   String    @id @default(uuid())
  workspaceId          String
  suppressionId        String?
  email                String
  normalizedEmail      String
  action               String    // ADDED, REMOVED, REACTIVATED, IMPORTED
  reason               String?
  source               String?
  performedByUserId    String?
  performedByUserEmail String?
  justification        String?
  metadata             Json?
  createdAt            DateTime  @default(now())
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, normalizedEmail])
  @@index([workspaceId, createdAt])
  @@map("suppression_audit_logs")
}

model ContactConsentAuditLog {
  id                   String    @id @default(uuid())
  workspaceId          String
  contactId            String
  channel              String    @default("SMS") // SMS, EMAIL
  previousStatus       String?   // PENDING, OPTED_IN, OPTED_OUT
  newStatus            String    // PENDING, OPTED_IN, OPTED_OUT
  source               String    @default("MANUAL") // MANUAL, IMPORT, API, WEB_FORM, KEYWORD_STOP, KEYWORD_START, DIRECT_TEST
  performedByUserId    String?
  performedByUserEmail String?
  notes                String?
  metadata             Json?
  createdAt            DateTime  @default(now())

  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact              Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([contactId])
  @@index([workspaceId, channel])
  @@index([workspaceId, createdAt])
  @@map("contact_consent_audit_logs")
}

model VerificationSettings {
  id                String    @id @default(uuid())
  workspaceId       String    @unique
  removeDuplicates  Boolean   @default(true)
  excludeDisposable Boolean   @default(true)
  flagCatchAll      Boolean   @default(true)
  excludeInvalid    Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("verification_settings")
}

model VerificationCreditLedger {
  id                String    @id @default(uuid())
  workspaceId       String
  userId            String?
  provider          String    @default("REOON")
  operation         String // SINGLE_VERIFY, BULK_VERIFY, REFUND
  creditsUsed       Int       @default(0)
  providerReference String?
  isMock            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@map("verification_credit_ledgers")
}

model EmailTemplate {
  id           String    @id @default(uuid())
  workspaceId  String
  userId       String?
  name         String
  description  String?
  category     String    @default("NEWSLETTER")
  status       String    @default("DRAFT")
  editorJson   Json?
  compiledHtml String?   @db.Text
  thumbnail    String?   @db.Text
  subject      String?
  preheader    String?
  tags         String[]  @default([])
  isStarred    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, category])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@map("email_templates")
}

model Campaign {
  id                String                     @id @default(uuid())
  workspaceId       String
  userId            String?
  name              String
  description       String?
  type              String                     @default("NEWSLETTER") // NEWSLETTER, PROMOTIONAL, PRODUCT_UPDATE, EVENT_INVITATION, RE_ENGAGEMENT
  status            String                     @default("DRAFT") // DRAFT, SCHEDULED, QUEUED, SENDING, COMPLETED, PAUSED, CANCELLED, FAILED, ARCHIVED
  fromName          String
  fromEmail         String
  replyTo           String?
  subject           String
  preheader         String?
  templateId        String?
  compiledHtml      String?                    @db.Text
  editorJson        Json?
  plainText         String?                    @db.Text
  audienceConfig    Json?
  utmParams         Json?
  trackingSettings  Json?
  postalAddress     String?
  batchSize         Int                        @default(100)
  batchDelayMs      Int                        @default(1000)
  scheduledAt       DateTime?
  timezone          String?                    @default("UTC")
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  pausedAt          DateTime?
  errorMessage      String?
  totalRecipients   Int                        @default(0)
  submittedCount    Int                        @default(0)
  deliveredCount    Int                        @default(0)
  openedCount       Int                        @default(0)
  clickedCount      Int                        @default(0)
  bouncedCount      Int                        @default(0)
  complainedCount   Int                        @default(0)
  unsubscribedCount Int                        @default(0)
  failedCount       Int                        @default(0)
  isArchived        Boolean                    @default(false)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  workspace         Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  snapshots         CampaignRecipientSnapshot[]
  sendingJobs       CampaignSendingJob[]
  events            EmailEvent[]
  metrics           CampaignMetric[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, createdAt])
  @@map("campaigns")
}

model CampaignRecipientSnapshot {
  id                 String                @id @default(uuid())
  campaignId         String
  contactId          String?
  email              String
  normalizedEmail    String
  firstName          String?
  lastName           String?
  company            String?
  city               String?
  customFields       Json?
  unsubscribeToken   String                @unique @default(uuid())
  status             String                @default("PENDING") // PENDING, SUBMITTED, DELIVERED, FAILED, EXCLUDED, BOUNCED, COMPLAINED, UNSUBSCRIBED
  exclusionReason    String?
  providerMessageId  String?
  errorMessage       String?
  submittedAt        DateTime?
  deliveredAt        DateTime?
  openedAt           DateTime?
  clickedAt          DateTime?
  bouncedAt          DateTime?
  unsubscribedAt     DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  campaign           Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact            Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sendingAttempts    EmailSendingAttempt[]

  @@index([campaignId])
  @@index([campaignId, status])
  @@index([normalizedEmail])
  @@index([unsubscribeToken])
  @@map("campaign_recipient_snapshots")
}

model CampaignSendingJob {
  id             String    @id @default(uuid())
  campaignId     String
  workspaceId    String
  idempotencyKey String    @unique
  batchIndex     Int       @default(0)
  totalBatches   Int       @default(1)
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, PAUSED, CANCELLED
  processedCount Int       @default(0)
  failedCount    Int       @default(0)
  errorMessage   String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([workspaceId])
  @@index([status])
  @@map("campaign_sending_jobs")
}

model EmailSendingAttempt {
  id                String                    @id @default(uuid())
  campaignId        String
  snapshotId        String
  recipientEmail    String
  status            String                    // SUBMITTED, FAILED
  provider          String                    @default("RESEND")
  providerMessageId String?
  responseCode      Int?
  error             String?
  attemptNumber     Int                       @default(1)
  createdAt         DateTime                  @default(now())

  snapshot          CampaignRecipientSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([snapshotId])
  @@map("email_sending_attempts")
}

model EmailEvent {
  id                String    @id @default(uuid())
  campaignId        String
  recipientEmail    String
  eventType         String    // SUBMITTED, DELIVERED, OPENED, CLICKED, BOUNCED, COMPLAINED, UNSUBSCRIBED
  provider          String    @default("RESEND")
  providerMessageId String?
  metadata          Json?
  createdAt         DateTime  @default(now())

  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([recipientEmail])
  @@index([eventType])
  @@map("email_events")
}

model CampaignMetric {
  id           String    @id @default(uuid())
  campaignId   String
  recordedAt   DateTime  @default(now())
  submitted    Int       @default(0)
  delivered    Int       @default(0)
  opens        Int       @default(0)
  clicks       Int       @default(0)
  bounces      Int       @default(0)
  unsubscribes Int       @default(0)

  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, recordedAt])
  @@map("campaign_metrics")
}

model SendingDomain {
  id             String            @id @default(uuid())
  workspaceId    String
  domain         String
  status         String            @default("PENDING") // PENDING, VERIFIED, PARTIALLY_VERIFIED, FAILED, NOT_STARTED
  resendDomainId String?
  region         String            @default("us-east-1")
  spfStatus      String            @default("PENDING") // VERIFIED, PENDING, FAILED, MISSING
  dkimStatus     String            @default("PENDING") // VERIFIED, PENDING, FAILED, MISSING
  dmarcStatus    String            @default("PENDING") // VERIFIED, PENDING, FAILED, MISSING
  dnsRecords     Json?
  lastCheckedAt  DateTime?
  errorMessage   String?
  isDefault      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sends          EmailSendRecord[]

  @@unique([workspaceId, domain])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("sending_domains")
}

model EmailSendRecord {
  id              String         @id @default(uuid())
  workspaceId     String
  userId          String?
  sendingDomainId String?
  resendId        String?        @unique
  recipientEmail  String
  normalizedEmail String
  senderEmail     String
  subject         String
  status          String         @default("SENT") // QUEUED, SENT, DELIVERED, BOUNCED, COMPLAINED, FAILED
  source          String         @default("TEST") // TEST, CAMPAIGN, SEQUENCE, TRANSACTIONAL
  errorMessage    String?
  rawResponse     Json?
  deliveredAt     DateTime?
  bouncedAt       DateTime?
  complainedAt    DateTime?
  bounceDetails   Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  sendingDomain   SendingDomain? @relation(fields: [sendingDomainId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, normalizedEmail])
  @@index([resendId])
  @@map("email_send_records")
}

model EmailWebhookEvent {
  id          String     @id @default(uuid())
  workspaceId String?
  resendId    String?
  eventType   String     // email.sent, email.delivered, email.bounced, email.complained, email.delivery_delayed
  payload     Json
  processed   Boolean    @default(false)
  createdAt   DateTime   @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([resendId])
  @@index([eventType])
  @@index([createdAt])
  @@map("email_webhook_events")
}

model SmsBroadcast {
  id              String       @id @default(uuid())
  workspaceId     String
  userId          String?
  name            String
  protocol        String       @default("SMS") // SMS, RCS
  status          String       @default("DRAFT") // DRAFT, SCHEDULED, SENT, ARCHIVED
  senderId        String       @default("NEXAREACH")
  messageText     String       @db.Text

  // RCS Rich Card Content
  rcsCardTitle    String?
  rcsActionLabel  String?
  rcsActionUrl    String?
  rcsMediaUrl     String?
  rcsSuggestion   String?

  // Audience Configuration
  audienceType    String       @default("ALL") // ALL, LIST, TEST
  listId          String?
  testPhone       String?
  audienceConfig  Json?

  // Telecom Estimation & Counts
  encoding        String       @default("GSM-7") // GSM-7, UCS-2
  characterCount  Int          @default(0)
  segments        Int          @default(1)
  totalRecipients Int          @default(0)
  totalSegments   Int          @default(0)

  // Scheduling & Delivery Timestamps
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("sms_broadcasts")
}

model SmsTemplate {
  id             String       @id @default(uuid())
  workspaceId    String
  userId         String?
  name           String
  description    String?
  protocol       String       @default("SMS") // SMS, RCS
  category       String       @default("GENERAL") // TRANSACTIONAL, PROMOTIONAL, ALERTS, MARKETING, GENERAL
  messageText    String       @db.Text

  // RCS Rich Card Content
  rcsCardTitle   String?
  rcsMediaUrl    String?
  rcsActionLabel String?
  rcsActionUrl   String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, protocol])
  @@index([workspaceId, category])
  @@index([workspaceId, updatedAt])
  @@map("sms_templates")
}

model SmsSettings {
  id                 String    @id @default(uuid())
  workspaceId        String    @unique
  defaultSenderId    String    @default("NEXAREACH")
  defaultChannel     String    @default("SMS") // SMS, RCS
  timezone           String    @default("UTC")
  enforceStopOptOut  Boolean   @default(true)
  encodingPreference String    @default("AUTO") // AUTO, GSM-7, UCS-2
  rcsBrandName       String    @default("NexaReach Marketing OS")
  rcsBrandColor      String    @default("#2563EB")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("sms_settings")
}

model VoiceCampaign {
  id               String          @id @default(uuid())
  workspaceId      String
  userId           String?
  name             String
  description      String?
  purpose          String          @default("NOTIFICATION") // NOTIFICATION, REMINDER, SURVEY, PROMOTIONAL, TRANSACTIONAL
  status           String          @default("DRAFT") // DRAFT, READY_FOR_REVIEW, SCHEDULED, QUEUED, COMPLETED, CANCELLED, FAILED
  
  // Voice Script & Configuration
  scriptText       String          @db.Text
  language         String          @default("en-US")
  voiceId          String          @default("alloy")
  speed            Float           @default(1.0)
  pitch            Float           @default(1.0)
  
  // Audience Configuration
  audienceType     String          @default("ALL") // ALL, LIST, SEGMENT, TEST
  listId           String?
  segmentId        String?
  testPhone        String?
  audienceConfig   Json?
  
  // Counts & Eligibility Snapshot (Server-Calculated)
  totalRecipients  Int             @default(0)
  eligibleCount    Int             @default(0)
  excludedCount    Int             @default(0)
  
  // Call Execution Metrics (Internal Simulation / Ready for Provider)
  completedCount   Int             @default(0)
  failedCount      Int             @default(0)
  busyCount        Int             @default(0)
  noAnswerCount    Int             @default(0)
  cancelledCount   Int             @default(0)
  
  // Scheduling & Lifecycle Timestamps
  scheduledAt      DateTime?
  timezone         String?         @default("UTC")
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  errorMessage     String?
  
  // Template linkage
  templateId       String?
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  callJobs         VoiceCallJob[]
  callEvents       VoiceCallEvent[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("voice_campaigns")
}

model VoiceCallJob {
  id                      String          @id @default(uuid())
  campaignId              String
  workspaceId             String
  contactId               String?
  destinationPhone        String
  destinationPhoneNorm    String
  countryCode             String?
  
  // Script with contact dynamic placeholders rendered
  renderedScript          String          @db.Text
  
  // Internal Call Status
  status                  String          @default("PENDING") // PENDING, QUEUED, IN_PROGRESS, COMPLETED, FAILED, BUSY, NO_ANSWER, CANCELLED, SKIPPED
  attemptCount            Int             @default(0)
  maxAttempts             Int             @default(3)
  
  // Execution Timestamps & Metrics
  scheduledAt             DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  callDurationSeconds     Int?            // Nullable until real data exists
  
  // Future Provider Abstraction Fields (Nullable)
  providerName            String?         // Nullable (e.g. TWILIO, VONAGE, PLIVO)
  providerCallId          String?         // Nullable
  
  // Error & Failure Diagnosis
  failureCode             String?
  failureReason           String?
  
  // Test / Dry-Run Flag
  isSimulated             Boolean         @default(true)
  
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  campaign                VoiceCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspace               Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact                 Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  events                  VoiceCallEvent[]

  @@unique([campaignId, destinationPhoneNorm])
  @@index([workspaceId])
  @@index([campaignId])
  @@index([campaignId, status])
  @@index([workspaceId, destinationPhoneNorm])
  @@map("voice_call_jobs")
}

model VoiceCallEvent {
  id              String         @id @default(uuid())
  workspaceId     String
  campaignId      String
  jobId           String?
  eventType       String         // CREATED, SCHEDULED, QUEUED, DISPATCH_SIMULATED, STATUS_CHANGED, CANCELLED, FAILED
  previousStatus  String?
  newStatus       String
  notes           String?
  metadata        Json?
  isSimulated     Boolean        @default(true)
  createdAt       DateTime       @default(now())

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign        VoiceCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  job             VoiceCallJob?  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignId])
  @@index([jobId])
  @@index([createdAt])
  @@map("voice_call_events")
}

model VoiceTemplate {
  id              String         @id @default(uuid())
  workspaceId     String
  userId          String?
  name            String
  description     String?
  category        String         @default("GENERAL") // REMINDER, NOTIFICATION, TRANSACTIONAL, MARKETING, SURVEY, GENERAL
  scriptText      String         @db.Text
  language        String         @default("en-US")
  voiceId         String         @default("alloy")
  speed           Float          @default(1.0)
  tags            String[]       @default([])
  isStarter       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, category])
  @@index([workspaceId, language])
  @@map("voice_templates")
}

model VoiceSettings {
  id                   String       @id @default(uuid())
  workspaceId          String       @unique
  defaultLanguage      String       @default("en-US")
  defaultVoice         String       @default("alloy")
  defaultSpeed         Float        @default(1.0)
  timezone             String       @default("UTC")
  
  // Calling Preferences
  callingWindowStart   String       @default("09:00")
  callingWindowEnd     String       @default("20:00")
  callingDays          String       @default("MON_FRI")
  quietHoursEnabled    Boolean      @default(true)
  maxRetryAttempts     Int          @default(3)
  retryIntervalMinutes Int          @default(30)
  
  // Compliance & Consent
  enforceConsent       Boolean      @default(true)
  enforceSuppression   Boolean      @default(true)
  requireOptInProof    Boolean      @default(true)
  
  // Future Provider Configuration
  providerStatus       String       @default("NOT_CONNECTED")
  providerName         String?
  
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  workspace            Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("voice_settings")
}



